# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgres://subsentry:subsentry@localhost:5432/subsentry

# Session signing AND OAuth-token encryption key: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Phone testing via a tunnel, e.g. PUBLIC_HOSTS=jean-subsentry.ngrok-free.app
# (also add https://<host> and its /api/auth/callback/google to the Google OAuth client)
PUBLIC_HOSTS=

# Google Cloud console → APIs & Services → Credentials → OAuth client (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Later milestones
ACTION_TOKEN_SECRET=

# Email extraction (M2). Free key: https://aistudio.google.com/apikey
# Free tier: Google may use requests to improve its models, so use it only for
# your own test inboxes. Switch to a paid key before onboarding other users.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
EXTRACT_MODEL=gemini-flash-lite-latest
LLM_MIN_INTERVAL_MS=6000

RESEND_API_KEY=
EMAIL_FROM=
