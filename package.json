{
  "name": "subsentry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "node --env-file=.env --import tsx src/worker/index.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "eval": "vitest run --config vitest.eval.config.mts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "icons": "tsx scripts/generate-icons.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@date-fns/tz": "^1.5.0",
    "@google/genai": "^2.30.0",
    "@googleapis/calendar": "^20.1.0",
    "@googleapis/gmail": "^22.0.2",
    "better-auth": "^1.7.8",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "html-to-text": "^10.0.1",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.33.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}
